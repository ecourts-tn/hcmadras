# CodeIgniter 4 specific ignores
/writable/cache/*
!writable/cache/.gitkeep
/writable/logs/*
!writable/logs/.gitkeep
/writable/session/*
!writable/session/.gitkeep
/writable/uploads/*
!writable/uploads/.gitkeep
/writable/debugbar/*
!writable/debugbar/.gitkeep

# Environment files
.env
.env.*
!.env.example

# Dependencies
/vendor/

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db